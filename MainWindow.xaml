<Window x:Class="IslaDinamica.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IslaDinamica" Width="480" Height="235"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Botón secundario circular (Anterior / Siguiente) con icono vectorial -->
        <Style x:Key="MediaCircleBtn" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#17171D"/>
            <Setter Property="BorderBrush" Value="#2A2A34"/>
            <Setter Property="Foreground" Value="#E5E5EA"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#262630"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#424252"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.1" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#323240"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón principal circular Play/Pausa estilo Apple/Spotify (fondo blanco brillante) -->
        <Style x:Key="MediaPlayPrimaryBtn" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#F5F5F7"/>
            <Setter Property="Foreground" Value="#07070A"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PlayBorder" Background="{TemplateBinding Background}"
                                CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PlayBorder" Property="Background" Value="#FFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.12" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.12" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PlayBorder" Property="Background" Value="#DCDCE2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para las pestañas/selectores y botones de acción de descarga -->
        <Style x:Key="TabPillBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#98989F"/>
            <Setter Property="Background" Value="#161618"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2.5,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder" Background="{TemplateBinding Background}"
                                BorderBrush="#26262A" BorderThickness="1"
                                CornerRadius="10" Padding="8,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="#45454C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tarjeta compacta para los juegos recientes (Top 2–4) -->
        <Style x:Key="GameRecentCardBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#121217"/>
            <Setter Property="BorderBrush" Value="#24242E"/>
            <Setter Property="Foreground" Value="#E5E5EA"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="9" Padding="6,5">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#1E1E28"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#4B4B60"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#282836"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="Island" Background="#050507" CornerRadius="0,0,20,20"
                BorderThickness="1,0,1,1"
                Width="240" Height="36" HorizontalAlignment="Center" VerticalAlignment="Top"
                ClipToBounds="True" MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave">
            <Border.LayoutTransform>
                <ScaleTransform x:Name="IslandScale" ScaleX="1" ScaleY="1"/>
            </Border.LayoutTransform>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1F1F24" Offset="0"/>
                    <GradientStop Color="#2E2E36" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Salir" Click="Exit_Click"/>
                </ContextMenu>
            </Border.ContextMenu>

            <Grid>
                <!-- ==================== VISTA COMPACTA (EN REPOSO) ==================== -->
                <Grid x:Name="CompactBar" Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="82"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="82"/>
                    </Grid.ColumnDefinitions>

                    <!-- Izquierda: Círculo verde de progreso de descarga -->
                    <Grid x:Name="CompactDlIndicator" Grid.Column="0" Width="22" Height="22"
                          HorizontalAlignment="Left" VerticalAlignment="Center"
                          Visibility="Collapsed" Cursor="Hand" ToolTip="Ver descarga"
                          Background="Transparent" MouseLeftButtonDown="CompactDl_Click">
                        <Ellipse Width="20" Height="20" Stroke="#1C3824" StrokeThickness="2.4"/>
                        <Ellipse x:Name="CompactDlRing" Width="20" Height="20"
                                 Stroke="#30D158" StrokeThickness="2.4"
                                 StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                 StrokeDashArray="0 100" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="CompactDlRingRotate" Angle="-90"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <TextBlock x:Name="CompactDlIcon" Text="⬇" Foreground="#30D158" FontSize="9"
                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Centro: Hora actual -->
                    <TextBlock x:Name="ClockText" Grid.Column="1" Text="12:00"
                               Foreground="#F5F5F7" FontSize="12.5" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Cursor="Hand" MouseLeftButtonDown="Clock_Click"/>

                    <!-- Derecha: Ecualizador animado de música + batería -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Grid x:Name="CompactMusicIndicator" Width="26" Height="20" Margin="0,0,6,0"
                              VerticalAlignment="Center"
                              Visibility="Collapsed" Cursor="Hand" ToolTip="Ver música"
                              Background="Transparent" MouseLeftButtonDown="CompactMusic_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Height="14">
                                <Border x:Name="EqBar1" Width="2.6" Height="5" CornerRadius="1.3" Background="#F5F5F7" Margin="1,0" VerticalAlignment="Center"/>
                                <Border x:Name="EqBar2" Width="2.6" Height="11" CornerRadius="1.3" Background="#F5F5F7" Margin="1,0" VerticalAlignment="Center"/>
                                <Border x:Name="EqBar3" Width="2.6" Height="7" CornerRadius="1.3" Background="#F5F5F7" Margin="1,0" VerticalAlignment="Center"/>
                                <Border x:Name="EqBar4" Width="2.6" Height="10" CornerRadius="1.3" Background="#F5F5F7" Margin="1,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Batería: porcentaje + icono (se oculta si el equipo no tiene batería) -->
                        <StackPanel x:Name="CompactBatteryIndicator" Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="Collapsed" Cursor="Hand" ToolTip="Ver batería"
                                    Background="Transparent" MouseLeftButtonDown="CompactBattery_Click">
                            <TextBlock x:Name="CompactBatteryText" Text="100%" Foreground="#F5F5F7"
                                       FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Grid Width="21" Height="10" Margin="4,0,0,0" VerticalAlignment="Center">
                                <Border Width="18" Height="10" HorizontalAlignment="Left"
                                        BorderBrush="#6E6E78" BorderThickness="1" CornerRadius="3"/>
                                <Border x:Name="CompactBatteryFill" Height="6" Width="14" Margin="2,0,0,0"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        CornerRadius="1.5" Background="#F5F5F7"/>
                                <Border Width="2" Height="4" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Background="#6E6E78" CornerRadius="0,1,1,0"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ==================== VISTA EXPANDIDA ==================== -->
                <Grid x:Name="ExpandedPanel" Opacity="0" Margin="16,12,16,14" IsHitTestVisible="False">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="ExpandedSlide" Y="-6"/>
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Barra superior: Hora a la izquierda + selectores clickeables (Música / Descargas) a la derecha -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock x:Name="ExpandedClockText" Text="12:00" Foreground="#8E8E93"
                                   FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="TabSummaryBtn" Style="{StaticResource TabPillBtn}" Click="TabSummary_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="● " Foreground="#64D2FF" FontSize="9" VerticalAlignment="Center"/>
                                    <TextBlock Text="Resumen"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="TabMusicBtn" Style="{StaticResource TabPillBtn}" Click="TabMusic_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="♪ " Foreground="#FF375F" FontWeight="Bold"/>
                                    <TextBlock Text="Música"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="TabDlBtn" Style="{StaticResource TabPillBtn}" Click="TabDl_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="● " Foreground="#30D158" FontSize="9" VerticalAlignment="Center"/>
                                    <TextBlock Text="Descargas"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="TabGamesBtn" Style="{StaticResource TabPillBtn}" Click="TabGames_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="◆ " Foreground="#A78BFA" FontSize="9.5" VerticalAlignment="Center"/>
                                    <TextBlock Text="Juegos"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Contenido del panel seleccionado -->
                    <Grid x:Name="ContentHost" Grid.Row="1">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="ContentSlide" Y="0"/>
                        </Grid.RenderTransform>

                        <!-- ==================== PANEL DE RESUMEN (BATERÍA) ==================== -->
                        <Grid x:Name="SummaryPanel" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Anillo de batería -->
                            <Grid Width="56" Height="56" VerticalAlignment="Center">
                                <Ellipse Width="52" Height="52" Fill="#141418" Stroke="#26262E" StrokeThickness="3.5"/>
                                <Ellipse x:Name="BatteryRing" Width="52" Height="52"
                                         Stroke="#30D158" StrokeThickness="3.5"
                                         StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                         StrokeDashArray="0 100" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="-90"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <TextBlock x:Name="BatteryRingText" Text="--" Foreground="#F5F5F7" FontSize="15"
                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="BatteryTitle" Text="Batería" Foreground="#F5F5F7" FontSize="14"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="BatterySub" Text="Leyendo estado…" Foreground="#8E8E93" FontSize="11.5"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                <Grid x:Name="BatteryBarTrack" Height="4.5" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="BatteryBarCol0" Width="0*"/>
                                        <ColumnDefinition x:Name="BatteryBarCol1" Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.ColumnSpan="2" Background="#24242C" CornerRadius="2.2"/>
                                    <Border x:Name="BatteryBarFill" Grid.Column="0" Background="#30D158" CornerRadius="2.2"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- ==================== PANEL DE MÚSICA ==================== -->
                        <Grid x:Name="MusicPanel" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Fila 1: Carátula (con indicador de estado) + título/artista + barras de audio -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Width="48" Height="48">
                                    <Border CornerRadius="11" Background="#141418"
                                            BorderBrush="#26262E" BorderThickness="1" ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="♪" Foreground="#3A3A44" FontSize="18"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image x:Name="Cover" Stretch="UniformToFill"/>
                                        </Grid>
                                    </Border>
                                    <!-- Punto de estado: verde = sonando, gris = en pausa -->
                                    <Ellipse x:Name="CoverStateDot" Width="13" Height="13" Fill="#30D158"
                                             Stroke="#050507" StrokeThickness="2.2"
                                             HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4"/>
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,10,0">
                                    <TextBlock x:Name="TitleText" Text="Sin reproducción" Foreground="#F5F5F7" FontSize="14"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="ArtistText" Text="Spotify o navegador" Foreground="#8E8E93" FontSize="11.5"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Barras de audio animadas (solo mientras suena y la isla está abierta) -->
                                <StackPanel x:Name="ExpandedEq" Grid.Column="2" Orientation="Horizontal"
                                            VerticalAlignment="Center" Height="18" Margin="0,0,2,0">
                                    <Border x:Name="XEqBar1" Width="3" Height="6" CornerRadius="1.5" Background="#F5F5F7" Margin="1.5,0" VerticalAlignment="Center"/>
                                    <Border x:Name="XEqBar2" Width="3" Height="14" CornerRadius="1.5" Background="#F5F5F7" Margin="1.5,0" VerticalAlignment="Center"/>
                                    <Border x:Name="XEqBar3" Width="3" Height="9" CornerRadius="1.5" Background="#F5F5F7" Margin="1.5,0" VerticalAlignment="Center"/>
                                    <Border x:Name="XEqBar4" Width="3" Height="13" CornerRadius="1.5" Background="#F5F5F7" Margin="1.5,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Fila 2: tiempo transcurrido · barra de progreso · duración -->
                            <Grid x:Name="ProgressRow" Grid.Row="1" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ElapsedText" Text="0:00" Foreground="#8E8E93" FontSize="10"
                                           FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="26"/>
                                <Grid x:Name="ProgressTrack" Grid.Column="1" Height="4.5" Margin="8,0">
                                    <Border Background="#24242C" CornerRadius="2.2"/>
                                    <Border x:Name="ProgressFill" Background="#F5F5F7" CornerRadius="2.2"
                                            HorizontalAlignment="Left" Width="0"/>
                                </Grid>
                                <TextBlock x:Name="TotalText" Grid.Column="2" Text="0:00" Foreground="#8E8E93" FontSize="10"
                                           FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="26" TextAlignment="Right"/>
                            </Grid>

                            <!-- Fila 3: controles centrados (Anterior · Play/Pausa · Siguiente) -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <Button Style="{StaticResource MediaCircleBtn}" Click="Prev_Click" ToolTip="Anterior">
                                    <Path Data="M 0,1 L 2,1 L 2,11 L 0,11 Z M 3.2,6 L 10.5,1 L 10.5,11 Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Stretch="Uniform" Width="10" Height="10"/>
                                </Button>
                                <Button x:Name="PlayBtn" Style="{StaticResource MediaPlayPrimaryBtn}" Margin="16,0" Click="Play_Click" ToolTip="Reproducir / Pausar">
                                    <Path x:Name="PlayPauseIconPath"
                                          Data="M 2,0 L 11,6 L 2,12 Z"
                                          Fill="#07070A" Stretch="Uniform" Width="11" Height="11" Margin="1,0,0,0"/>
                                </Button>
                                <Button Style="{StaticResource MediaCircleBtn}" Click="Next_Click" ToolTip="Siguiente">
                                    <Path Data="M 8.5,1 L 10.5,1 L 10.5,11 L 8.5,11 Z M 0,1 L 7.3,6 L 0,11 Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Stretch="Uniform" Width="10" Height="10"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- ==================== PANEL DE DESCARGAS ==================== -->
                        <Grid x:Name="DownloadPanel" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Círculo grande de progreso verde en el panel expandido -->
                            <Grid Width="56" Height="56" VerticalAlignment="Center">
                                <Ellipse Width="52" Height="52" Fill="#0F1F15" Stroke="#1C3824" StrokeThickness="3.5"/>
                                <Ellipse x:Name="ExpandedDlRing" Width="52" Height="52"
                                         Stroke="#30D158" StrokeThickness="3.5"
                                         StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                         StrokeDashArray="0 100" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="-90"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <TextBlock x:Name="DlIcon" Text="⬇" Foreground="#30D158" FontSize="20"
                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Cabecera de descarga + Botón Pausar/Continuar a la derecha -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock x:Name="DlTitle" Text="Sin descargas activas" Foreground="#F5F5F7" FontSize="14"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="DlSub" Text="Las descargas de navegador y Steam aparecerán aquí" Foreground="#8E8E93" FontSize="11.5"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Botón Pausar / Continuar descarga -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Botón Cancelar descarga (se muestra junto con el de pausa; pide un segundo clic) -->
                                        <Button x:Name="DlCancelBtn" Style="{StaticResource MediaCircleBtn}"
                                                Width="32" Height="32" Margin="0,0,8,0"
                                                Visibility="{Binding Visibility, ElementName=DlPauseResumeBtn}"
                                                Click="DlCancel_Click" ToolTip="Cancelar descarga">
                                            <Path x:Name="DlCancelPath" Data="M 0,0 L 10,10 M 10,0 L 0,10"
                                                  Stroke="#8E8E93" StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Stretch="Uniform" Width="10" Height="10"/>
                                        </Button>

                                        <!-- Botón Pausar / Continuar descarga -->
                                        <Button x:Name="DlPauseResumeBtn" Style="{StaticResource MediaCircleBtn}"
                                                Width="32" Height="32" Visibility="Collapsed"
                                                Click="DlPauseResume_Click" ToolTip="Pausar / Continuar descarga">
                                            <Path x:Name="DlPauseResumePath"
                                                  Data="M 1,0 L 4,0 L 4,11 L 1,11 Z M 7,0 L 10,0 L 10,11 L 7,11 Z"
                                                  Fill="#30D158" Stretch="Uniform" Width="10" Height="10"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Grid x:Name="DlProgressTrack" Grid.Row="1" Height="4.5" Margin="0,10,0,0" Visibility="Collapsed">
                                    <Border Background="#1C3824" CornerRadius="2.2"/>
                                    <Border x:Name="DlProgressFill" Background="#30D158" CornerRadius="2.2"
                                            HorizontalAlignment="Left" Width="0"/>
                                </Grid>

                                <Button x:Name="OpenBtn" Grid.Row="2" Style="{StaticResource TabPillBtn}"
                                        Content="Abrir ubicación ↗" FontSize="11.5" Margin="0,8,0,0"
                                        HorizontalAlignment="Left" Foreground="#30D158"
                                        Visibility="Collapsed" Click="OpenFolder_Click"/>
                            </Grid>
                        </Grid>

                        <!-- ==================== PANEL DE JUEGOS (FASE 7) ==================== -->
                        <Grid x:Name="GamesPanel" Visibility="Collapsed" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Fila 1: Último juego destacado -->
                            <Border Grid.Row="0" Background="#101016" BorderBrush="#23232E" BorderThickness="1"
                                    CornerRadius="12" Padding="9,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Carátula panorámica de Steam -->
                                    <Border CornerRadius="8" Width="96" Height="50" Background="#181822"
                                            BorderBrush="#2C2C3A" BorderThickness="1" ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="◆" Foreground="#3E3E52" FontSize="20"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image x:Name="FeaturedGameCover" Stretch="UniformToFill"/>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,10,0">
                                        <TextBlock x:Name="FeaturedGameBadge" Text="ÚLTIMO JUGADO" Foreground="#A78BFA"
                                                   FontSize="9" FontWeight="Bold"/>
                                        <TextBlock x:Name="FeaturedGameTitle" Text="Buscando juegos en Steam…"
                                                   Foreground="#F5F5F7" FontSize="13.5" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                        <TextBlock x:Name="FeaturedGameSub" Text="Tus últimos juegos aparecerán aquí"
                                                   Foreground="#8E8E93" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                        <!-- Si se está actualizando en Steam, muestra el progreso aquí mismo -->
                                        <Grid x:Name="FeaturedGameDlTrack" Height="4" Margin="0,5,0,0" Visibility="Collapsed">
                                            <Border Background="#1C3824" CornerRadius="2"/>
                                            <Border x:Name="FeaturedGameDlFill" Background="#30D158" CornerRadius="2"
                                                    HorizontalAlignment="Left" Width="0"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Botón grande Ejecutar / Ver actualización -->
                                    <Button x:Name="FeaturedPlayBtn" Grid.Column="2" Style="{StaticResource TabPillBtn}"
                                            Background="#A78BFA" Foreground="#07070A" FontWeight="Bold" FontSize="11.5"
                                            VerticalAlignment="Center" Margin="0" Visibility="Collapsed"
                                            Click="FeaturedGamePlay_Click" ToolTip="Ejecutar en Steam">
                                        <TextBlock x:Name="FeaturedPlayBtnText" Text="Jugar ▶" Margin="4,2"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Fila 2: Lista compacta de recientes (siguientes 3 juegos) -->
                            <Grid x:Name="RecentGamesRow" Grid.Row="1" Margin="0,8,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Reciente #2 -->
                                <Button x:Name="RecentGameBtn1" Grid.Column="0" Style="{StaticResource GameRecentCardBtn}"
                                        Margin="0,0,4,0" Visibility="Collapsed" Click="RecentGame1_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="6" Background="#1B1B24" ClipToBounds="True">
                                            <Image x:Name="RecentGameImg1" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock x:Name="RecentGameName1" Grid.Column="1" Text="" Foreground="#E5E5EA"
                                                   FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Margin="7,0,4,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="▶" Foreground="#A78BFA" FontSize="9"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>

                                <!-- Reciente #3 -->
                                <Button x:Name="RecentGameBtn2" Grid.Column="1" Style="{StaticResource GameRecentCardBtn}"
                                        Margin="2,0,2,0" Visibility="Collapsed" Click="RecentGame2_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="6" Background="#1B1B24" ClipToBounds="True">
                                            <Image x:Name="RecentGameImg2" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock x:Name="RecentGameName2" Grid.Column="1" Text="" Foreground="#E5E5EA"
                                                   FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Margin="7,0,4,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="▶" Foreground="#A78BFA" FontSize="9"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>

                                <!-- Reciente #4 -->
                                <Button x:Name="RecentGameBtn3" Grid.Column="2" Style="{StaticResource GameRecentCardBtn}"
                                        Margin="4,0,0,0" Visibility="Collapsed" Click="RecentGame3_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="6" Background="#1B1B24" ClipToBounds="True">
                                            <Image x:Name="RecentGameImg3" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock x:Name="RecentGameName3" Grid.Column="1" Text="" Foreground="#E5E5EA"
                                                   FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Margin="7,0,4,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="▶" Foreground="#A78BFA" FontSize="9"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
